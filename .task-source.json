  "entities": [
    {
      "id": "media_asset",
      "label": "媒体资产",
      "relations": [
        "rendition.uses.media_asset",
        "provenance_edge.references.media_asset"
      ],
      "invariants": [
        "资产创建后字节和描述不可变",
        "内容长度与 SHA-256 必须匹配请求字节",
        "只有通过 WAV 或 Y4M 探测的字节才能形成资产记录"
      ]
    },
    {
      "id": "rendition",
      "label": "派生任务",
      "relations": [
        "rendition.produces.media_asset",
        "provenance_edge.describes.rendition"
      ],
      "invariants": [
        "终态不可再次转换",
        "completed 必须同时拥有输出资产和唯一谱系边",
        "failed 不得暴露输出资产"
      ]
    },
    {
      "id": "provenance_edge",
      "label": "谱系边",
      "relations": [
        "provenance_edge.links.rendition",
        "provenance_edge.links.media_asset"
      ],
      "invariants": [
        "每个 completed 派生只有一条谱系边",
        "父子资产标识与派生记录一致",
        "配方摘要与派生记录一致"
      ]
    },
    {
      "id": "integrity_check",
      "label": "完整性检查",
      "relations": [
        "integrity_check.reproduces.rendition"
      ],
      "invariants": [
        "verified 必须同时匹配媒体描述和输出摘要",
        "mismatch 必须保留可观察原因",
        "检查结果写入后不可改写"
      ]
    }
  ],
  "state_machines": [
    {
      "subject": "rendition",
      "states": [
        "queued",
        "running",
        "completed",
        "failed"
      ],
      "transitions": [
        "queued->running",
        "running->completed",
        "running->failed"
      ],
      "invariants": [
        "completed 和 failed 均为终态",
        "completed 前必须提交输出资产与谱系边",
        "失败不得留下引用不存在的输出资产"
      ]
    },
    {
      "subject": "integrity_check",
      "states": [
        "pending",
        "verified",
        "mismatch"
      ],
      "transitions": [
        "pending->verified",
        "pending->mismatch"
      ],
      "invariants": [
        "verified 需要字节摘要和媒体描述同时一致",
        "mismatch 需要稳定原因",
        "终态不可改写"
      ]
    }
  ],
